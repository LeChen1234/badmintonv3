{
  "version": "2026.07.1",
  "split_seed": "badminton-release-v1",
  "group_key_priority": ["subject_code", "match_uuid", "task_batch_uuid"],
  "splits": {"train": 0.70, "validation": 0.15, "test": 0.15},
  "release_requirements": {
    "only_locked_batches": true,
    "minimum_matches": 3,
    "minimum_action_classes": 2,
    "minimum_pose_coverage": 0.80
  },
  "agreement": {
    "minimum_double_annotated_items": 20,
    "pck_thresholds": [0.05, 0.10]
  },
  "active_learning": {
    "minimum_rounds": 3,
    "stopping_patience": 2,
    "minimum_macro_f1_gain_per_hour": 0.002,
    "confidence_z": 1.96,
    "weight_update_rate": 0.30,
    "minimum_component_weight": 0.05,
    "initial_component_weights": {
      "motion": 0.40,
      "entropy": 0.25,
      "spectral": 0.20,
      "calculus": 0.15
    },
    "influence_lite": {
      "version": "influence-lite-v1",
      "sample_unit": "player_temporal_clip",
      "cold_start_until_completion_ratio": 0.20,
      "cold_start_weights": {"temporal_novelty": 0.50, "uncertainty": 0.15, "class_rarity": 0.25, "correction": 0.10},
      "model_guided_weights": {"temporal_novelty": 0.25, "uncertainty": 0.35, "class_rarity": 0.25, "correction": 0.15},
      "gradient_blend_weight": 0.50,
      "cost_adjustment": "influence/sqrt(seconds/45)",
      "automatic_deletion": false
    },
    "teacher_surrogate": {
      "version": "teacher-surrogate-v1",
      "minimum_paired_teacher_samples": 10,
      "minimum_pairs_per_class": 2,
      "uncalibrated_prior_shrinkage": 0.12,
      "quality_risk_weights": {
        "label_conflict": 0.35,
        "model_gap": 0.25,
        "temporal_jump": 0.25,
        "redundancy": 0.15
      },
      "never_treat_entropy_alone_as_bad_data": true,
      "automatic_deletion": false
    }
  }
}
