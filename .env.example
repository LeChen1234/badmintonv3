# ── PostgreSQL ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=badminton
POSTGRES_PASSWORD=badminton_secret_2024
POSTGRES_DB=badminton_annotation

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379

# ── MinIO ──
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_BUCKET=badminton-frames
MINIO_USE_SSL=false

# ── Label Studio ──
LABEL_STUDIO_HOST=http://label-studio:8080
LABEL_STUDIO_USERNAME=admin@badminton.local
LABEL_STUDIO_PASSWORD=admin_ls_2024
LABEL_STUDIO_API_KEY=your_label_studio_api_key_here

# ── ML Backend ──
ML_BACKEND_HOST=http://ml-backend:9090
ML_BACKEND_LOG_LEVEL=INFO

# ── FastAPI Backend ──
ENVIRONMENT=development
BACKEND_SECRET_KEY=replace_with_at_least_32_random_characters
BACKEND_ALGORITHM=HS256
BACKEND_ACCESS_TOKEN_EXPIRE_MINUTES=480
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace_before_first_start
ALLOW_PUBLIC_REGISTER=true
ANNOTATION_TAXONOMY_PATH=./config/annotation_taxonomy.json

# Multi-person auxiliary annotation (production-tunable, no code changes required)
POSE_YOLO_MODEL=yolov8n-pose.pt
POSE_YOLO_CONFIDENCE=0.12
POSE_YOLO_IOU=0.55
POSE_YOLO_IMAGE_SIZE=1280
POSE_MAX_PERSONS=20
POSE_ENABLE_TILING=true
POSE_TILE_MIN_SIDE=1080
POSE_MIN_VISIBLE_JOINTS=5
